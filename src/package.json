{
  "name": "backwhentv-windows",
  "productName": "BackWhenTV",
  "version": "1.2.0",
  "description": "BackWhenTV for Windows: cable TV, the way you remember it.",
  "main": "main.js",
  "author": "BackWhenTV",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "dependencies": {
    "hls.js": "^1.5.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "stream.backwhen.tv",
    "productName": "BackWhenTV",
    "icon": "icon.png",
    "directories": { "output": "dist" },
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      "renderer/**/*",
      "node_modules/hls.js/dist/hls.min.js",
      "node_modules/hls.js/package.json"
    ],
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "artifactName": "${productName}-Setup-${version}.${ext}", "oneClick": true },
    "portable": { "artifactName": "${productName}-Portable-${version}.${ext}" }
  }
}
