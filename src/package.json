{
  "name": "ltn-tv",
  "productName": "LTN TV",
  "version": "2.2.0",
  "description": "LTN TV: Love Thy Nerd, always on.",
  "main": "main.js",
  "author": "Love Thy Nerd",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "dependencies": {
    "hls.js": "^1.5.0",
    "@stagetimerio/grandiose": "^0.2.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "tv.lovethynerd.ltntv",
    "productName": "LTN TV",
    "icon": "icon.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      "renderer/**/*",
      "node_modules/hls.js/dist/hls.min.js",
      "node_modules/hls.js/package.json",
      "node_modules/@stagetimerio/grandiose/dist/**/*",
      "node_modules/@stagetimerio/grandiose/package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "LTN-TV-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LTN TV",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "LTN-TV-Portable-${version}.${ext}"
    },
    "asarUnpack": [
      "node_modules/@stagetimerio/grandiose/dist/**"
    ],
    "npmRebuild": false
  }
}
